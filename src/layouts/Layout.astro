---
import Navbar from '../components/Navbar.astro'
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import '../styles/global.css';

const { title } = Astro.props;
const desc = "Meet Madilyn Tavares, an experienced programmer and champion of human-first development."
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/leaves.svg" />
		<link rel="icon" href="/leaves.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={desc} />
		<link rel="canonical" href={canonicalURL} />
		<meta
			property="og:title"
			content="Maddie Tavares - Human-First Web Dev"
		/>
		<meta
			property="og:description"
			content={desc}
		/>
		<meta
			property="og:url"
			content={canonicalURL}
		/>
		<meta 
			name="twitter:card"
			content="summary"
		/>
		<Font cssVariable='--font-caveat' />
		<Font cssVariable='--font-nunito' />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="app-shell">
			<Navbar />
			<main id="main-content">
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	.app-shell {
		display: flex;
		min-height: 100vh;
		align-items: stretch;
	}

	main {
		flex: 1 1 auto;
		min-width: 0;
		padding: var(--space-5) var(--space-3);
	}

	@media (max-width: 860px) {
		.app-shell {
			flex-direction: column;
		}

		main {
			padding-top: calc(var(--topbar-height) + var(--space-4));
		}
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import HeroTile from '../components/HeroTile.astro';
import AboutTile from '../components/AboutTile.astro';
import PitchTile from '../components/PitchTile.astro';

const backgroundColor = "rgb(221 185 136)";
---

<Layout title="Home - Maddie Tavares">
	<HeroTile />
	<AboutTile />
	<PitchTile />
</Layout>


<style define:vars={{backgroundColor}}>
	h1 {
		display: inline;
		background-color: var(--backgroundColor);
	}
</style>
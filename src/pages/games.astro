---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';

const games = await Promise.all(
    (await getCollection('gameProjects'))
        .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
        .map(async (entry) => ({ entry, Content: (await render(entry)).Content, hasBody: !!entry.body?.trim() }))
);
---

<Layout title="Games - Maddie Tavares">
	<PageHeader
		title="Games"
		lede="Before my foray into full-stack development, I was a gameplay programmer for a handful of years. I worked primarily in the Unity engine with C#. Take a look at some of my projects:"
	/>

	<div class="projects-grid">
		{games.map(({ entry: game, Content, hasBody }) => (
			<ProjectCard
				title={game.data.title}
				summary={game.data.summary}
				tags={game.data.tags}
				year={game.data.year}
				meta={game.data.engine}
				image={game.data.image ? game.data.image : undefined}
				imageAlt={game.data.imageAlt}
				primaryLink={game.data.playUrl ? { label: 'Play', url: game.data.playUrl } : undefined}
				secondaryLink={game.data.repoUrl ? { label: 'Code', url: game.data.repoUrl } : undefined}
			>{hasBody && <Content />}</ProjectCard>
		))}
	</div>
</Layout>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(280px, 1fr));
		gap: var(--space-3);
		width: var(--page-content-width);
		margin: 0 0 var(--space-5) auto;
	}

	@media (max-width: 1170px) {
		.projects-grid {
			grid-template-columns: repeat(2, minmax(280px, 1fr));
		}
	}

	@media (max-width: 860px) {
		.projects-grid
		{
			display: block;
			width: 100%;
			margin: 0 auto;
		}
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const games = (await getCollection('gameProjects')).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year
);
---

<Layout title="Games - Maddie Tavares">
	<PageHeader
		title="Games"
		lede="Before my foray into full-stack development, I was a gameplay programmer for a handful of years. I worked primarily in the Unity engine with C#. Take a look at some of my projects:"
	/>

	<div class="projects-grid">
		{games.map((game) => (
			<ProjectCard
				title={game.data.title}
				summary={game.data.summary}
				tags={game.data.tags}
				year={game.data.year}
				meta={game.data.engine}
				primaryLink={game.data.playUrl ? { label: 'Play', url: game.data.playUrl } : undefined}
				secondaryLink={game.data.repoUrl ? { label: 'Code', url: game.data.repoUrl } : undefined}
			/>
		))}
	</div>
</Layout>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-3);
		width: var(--page-content-width);
		margin: 0 0 var(--space-5) auto;
	}
</style>

---
import  Layout  from "../layouts/Layout.astro";

const backgroundColor = "rgb(221 185 136)";
const textColor = "rgb(96 65 14)";
---

<Layout title="Games - Maddie Tavares">
    <div>
        <div id="title-container">
            <h1>Games</h1>
            <p>Before my foray into full-stack development, I was a gameplay programmer for a handful of years. I worked primarily
                in the Unity engine with C#. Take a look at some of my projects:
            </p>
        </div>
        <div id="games-container">

        </div>
    </div>
</Layout>

<style define:vars={{backgroundColor, textColor}}>
    div {
        background-color: var(--backgroundColor);
        float: right;
        width: 80%;
        padding-bottom: 1em;
    }

    #title-container {
        width: 100%;
    }

    #games-container {
        width: 100%;
    }

    h1 {
        color: var(--textColor);
        font-family: var(--font-kalam), Georgia, serif;
        font-size: 4em;
        text-align: center;
        width: 60%;
        padding-top: 1em;
        margin: 0 auto;
    }

    p {
        color: var(--textColor);
        font-family: var(--font-dm-mono), monospace;
        text-align: center;
        width: 50%;
        margin: 0 auto;
    }
</style>
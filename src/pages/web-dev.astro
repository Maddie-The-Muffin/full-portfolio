---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';

const projects = await Promise.all(
    (await getCollection('webProjects'))
        .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
        .filter((project) => project.data.display)
        .map(async (entry) => ({ entry, Content: (await render(entry)).Content, hasBody: !!entry.body?.trim() }))
);
---

<Layout title="Web Dev - Maddie Tavares">
	<PageHeader
		title="Web Dev"
		lede="I build full-stack web apps with the PERN stack (PostgreSQL, Express, React, Node.js), along with some Astro and Next.js on the side. 
		Here's some of what I've been working on (click/tap each card for more details):"
	/>

	<div class="projects-grid">
		{projects.length > 0 ? projects.map(({ entry: project, Content, hasBody }) => (
			<ProjectCard
				title={project.data.title}
				summary={project.data.summary}
				tags={project.data.tags}
				year={project.data.year}
				image={project.data.image ? project.data.image : undefined}
				imageAlt={project.data.imageAlt}
				primaryLink={project.data.liveUrl ? { label: 'Live site', url: project.data.liveUrl } : undefined}
				secondaryLink={project.data.repoUrl ? { label: 'Code', url: project.data.repoUrl } : undefined}
			>{hasBody && <Content />}</ProjectCard>
		)) : (<p class="placeholder">Check back soon for updates!</p>)
		}
	</div>
</Layout>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(280px, 1fr));
		gap: var(--space-3);
		width: var(--page-content-width);
		margin: 0 0 var(--space-5) auto;
	}

	.placeholder {
		color: var(--color-text-muted);
		text-align: center;
	}

	@media (max-width: 1170px) {
		.projects-grid {
			grid-template-columns: repeat(2, minmax(280px, 1fr));
		}
	}

	@media (max-width: 860px) {
		.projects-grid 
		{
			display: block;
			width: 100%;
			margin: 0 auto;
		}
	}
</style>

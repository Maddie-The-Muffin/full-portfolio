---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout title="Contact - Maddie Tavares">
	<PageHeader
		title="Contact"
		lede="Got a project in mind, a question, or just want to chat? Send it my way!"
	/>

	<ContactForm />

	<section class="mail" aria-label="direct-email">
		<p>Form not working? Email me directly at <a href="mailto:maddietavdev@gmail.com">maddietavdev@gmail.com</a></p>
	</section>

	<section class="working-hours" aria-label="Working hours">
		<p>My working hours are (as of right now) 10am-4pm EST, Monday-Thursday. Subject to change without notice.</p>
		<p>Projects I feel comfortable taking on include simple landing pages, small interactive apps and internal dashboards. I will not accept 
			any projects involving e-commerce, payment authorization, or anything else involving major complexities. If you 
			have an idea and are in doubt what catgory it falls into - ask! (I reserve the right to decline any project proposal.)
		</p>
	</section>

	<section class="elsewhere" aria-label="Find me elsewhere">
		<p>You can also find me on:</p>
		<ul>
			<li><a href="https://github.com/Maddie-The-Muffin" target="_blank" referrerpolicy="no-referrer">GitHub</a></li>
			<li><a href="https://www.linkedin.com/in/madilyn-tavares/" target="_blank" referrerpolicy="no-referrer">LinkedIn</a></li>
		</ul>
	</section>
</Layout>

<style>
	.working-hours {
		width: var(--page-content-width);
		margin: var(--space-2) 0 0 auto;
		text-align: center;
	}

	.working-hours p {
		width: 70%;
		font-size: 12px;
		margin: 0 auto var(--space-1) auto;
	}

	.mail {
		width: var(--page-content-width);
		margin: var(--space-2) 0 0 auto;
		text-align: center;
	}

	.mail p {
		width: 70%;
		margin: 0 auto var(--space-1) auto;
	}

	.elsewhere {
		width: var(--page-content-width);
		margin: var(--space-1) 0 0 auto;
		text-align: center;
	}

	.elsewhere ul {
		list-style: none;
		display: flex;
		gap: 1.5em;
		justify-content: center;
		padding: 0;
	}

	.elsewhere a {
		font-weight: 700;
	}

	.noshow {
		display: none;
	}

	@media (max-width: 860px) {
		.working-hours, .elsewhere, .mail {
			width: 100%;
			margin: 0 auto;
		}

		.working-hours p, .mail p {
			width: 90%;
		}
	}
</style>

---
---
<div class="contact-container">
<form class="contact-form postcard" action="https://formspree.io/f/mljelrqk" method="POST">
    
    <div class="field">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" maxlength="100" required autocomplete="name" />
        <span class="error-message" id="name-error" role="alert"></span>
    </div>

    <div class="field">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" maxlength="100" required autocomplete="email" />
        <span class="error-message" id="email-error" role="alert"></span>
    </div>

    <div class="field">
        <label for="message">Message *</label>
        <textarea id="message" name="message" rows="6" maxlength="1000" required></textarea>
        <span class="error-message" id="message-error" role="alert"></span>
    </div>

    <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        class="hp-field"
        aria-hidden="true"
    />

    <button type="submit" class="btn btn-primary">Send</button>
</form>
</div>

<script>
    function initContactForm() {
    const form = document.querySelector('.contact-form');
    if (form) {
        const nameInput = form.querySelector('#name') as HTMLInputElement | null;
        const emailInput = form.querySelector('#email') as HTMLInputElement | null;
        const messageInput = form.querySelector('#message') as HTMLTextAreaElement | null;
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        type Field = {
            input: HTMLInputElement | HTMLTextAreaElement | null;
            errorEl: HTMLElement | null;
            validate: (value: string) => boolean;
            message: string;
        };

        const fields: Field[] = [
            {
                input: nameInput,
                errorEl: document.getElementById('name-error'),
                validate: (value) => value.trim().length > 0,
                message: 'Please enter your name.',
            },
            {
                input: emailInput,
                errorEl: document.getElementById('email-error'),
                validate: (value) => emailPattern.test(value.trim()),
                message: 'Please enter a valid email address.',
            },
            {
                input: messageInput,
                errorEl: document.getElementById('message-error'),
                validate: (value) => value.trim().length > 0,
                message: 'Please enter a message.',
            },
        ];

        function isFieldValid(field: Field) {
            return Boolean(field.input) && field.validate(field.input!.value);
        }

        function showError(field: Field) {
            if (field.errorEl) field.errorEl.textContent = field.message;
            field.input?.setAttribute('aria-invalid', 'true');
        }

        function clearError(field: Field) {
            if (field.errorEl) field.errorEl.textContent = '';
            field.input?.removeAttribute('aria-invalid');
        }

        function updateSubmitState() {
            const allValid = fields.every(isFieldValid);
            if (submitBtn) submitBtn.disabled = !allValid;
            return allValid;
        }

        fields.forEach((field) => {
            field.input?.addEventListener('input', () => {
                if (isFieldValid(field)) {
                    clearError(field);
                } else if (field.errorEl) {
                    field.errorEl.textContent = '';
                }
                updateSubmitState();
            });

            field.input?.addEventListener('blur', () => {
                if (!isFieldValid(field)) {
                    showError(field);
                }
            });
        });

        form.addEventListener('submit', (event) => {
            const allValid = updateSubmitState();
            if (!allValid) {
                event.preventDefault();
                fields.forEach((field) => {
                    if (!isFieldValid(field)) {
                        showError(field);
                    }
                });
            }
        });

        updateSubmitState();
    }
    }

    document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
    .contact-container {
        width: var(--page-content-width);
        margin: 0 0 0 auto;
    }

    .contact-form {
        max-width: 32rem;
        margin: 0 auto;
        padding: var(--space-4);
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.35em;
    }

    label {
        font-family: var(--font-heading);
        font-size: 1.2rem;
    }

    input,
    textarea {
        font-family: var(--font-body);
        font-size: 1rem;
        padding: 0.6em 0.8em;
        border-radius: 8px;
        border: 1px dashed var(--color-border);
        background: var(--color-bg);
        color: var(--color-text);
    }

    input:focus,
    textarea:focus {
        outline: 2px solid var(--color-primary);
        outline-offset: 1px;
    }

    input[aria-invalid='true'],
    textarea[aria-invalid='true'] {
        border-color: var(--color-error);
    }

    .error-message {
        min-height: 1.2em;
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: var(--color-error);
    }

    .hp-field {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    button {
        align-self: flex-start;
        border: none;
        font-size: 1rem;
    }

    button:enabled {
        cursor: pointer;
    }

    @media (max-width: 860px) {
        .contact-container {
            width: 100%;
            margin: 0 auto var(--space-4) auto;
        }

        .contact-form {
            padding: var(--space-3);
        }
    }
</style>

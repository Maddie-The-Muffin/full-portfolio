---
import { Image } from 'astro:assets';
import testImage from '../assets/patchyzinha sticker.png';

const backgroundColor = "rgb(96 65 14)";
const textColor = "rgb(221 185 136)";
---

<div id="container">
    <h2>About Me</h2>
    <div id="main">
        <Image class="me" src={testImage} alt="test" layout='constrained' height={100}/>
        <p>My name is Madilyn Tavares, but I go by Maddie. I have a full 3 years of professional
            programming experience and have been in full stack development since May of 2026, when I began
            a full stack development bootcamp. I work mostly in the <b>PERN (PostgreSQL, Express, React, Node.js) stack</b>, but I have some
            experience using <b>Astro</b> and <b>MongoDB</b> as well. In addition, I have also worked in <b>C#</b> for several years, both in a
            hobbyist and professional capacity.
            <br><br>
            In my free time, I'm either reading epic fantasies, writing stories, catching up on baseball, or simply taking in the gorgeous
            Blue Ridge Mountain Views.
            <br><br>
            Interested in having me make a website for you? <a href="#">Contact me today!</a>
        </p>
    </div>
</div>

<style define:vars={{backgroundColor, textColor}}>
    #container {
        background-color: var(--backgroundColor);
        float: right;
        width: 80%;
        height: 90%;
    }

    h2 {
        color: var(--textColor);
        text-align: center;
        font-family: var(--font-kalam), Georgia, serif;
        font-size: 3em;
        margin-bottom: 0.25em;
    }

    #main {
        width: 50%;
        margin: 0 auto;
        display: flex;
    }

    .me {
        height: 20%;
    }

    p {
        font-family: var(--font-dm-mono), monospace;
        color: var(--textColor);
        text-align: justify;
    }
</style>
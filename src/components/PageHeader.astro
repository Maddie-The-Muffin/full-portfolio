---
interface Props {
    title: string;
    lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="page-header">
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
</header>

<style>
    .page-header {
        width: var(--page-content-width);
        margin: 0 0 var(--space-4) auto;
        text-align: center;
    }

    .lede {
        width: 75%;
        font-size: 1.15rem;
        color: var(--color-text-muted);
        margin: 0 auto var(--space-4);
    }
</style>

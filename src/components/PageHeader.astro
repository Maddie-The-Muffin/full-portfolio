---
interface Props {
    title: string;
    lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="page-header">
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
</header>

<style>
    .page-header {
        max-width: 42rem;
        margin: 0 auto var(--space-4);
        text-align: center;
    }

    .lede {
        font-size: 1.15rem;
        color: var(--color-text-muted);
    }
</style>

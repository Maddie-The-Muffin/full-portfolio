---
import { Image } from "astro:assets";
import testImage from "../assets/random filler image.png";

const { image } = Astro.props;
---

<div class="container">
    <div class="img">
        <Image class="thumbnail" src={testImage} alt="test" />
    </div>

    <div>
        <h2>Golden Gloves VR</h2>
        <p>A game of gloves</p>
    </div>
</div>

<style>
    .container {
        width: 25em;
        height: 25em;
        background-color: aqua;
        border-radius: 1em;
    }

    .img {
        height: 50%;
        overflow: clip;
        border-top-left-radius: 1em;
        border-top-right-radius: 1em;
    }

    .thumbnail {

    }
</style>
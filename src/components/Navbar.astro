---
const backgroundColor = "rgb(197 211 178)";
---


<div id="navbar">
    <p class="text" id="title">Maddie Tavares</p>
    <a class="text" href="#">Home</a>
    <a class="text" href="#">Websites</a>
    <a href="#" class="text">Games</a>
</div>

<style define:vars={{backgroundColor}}>
    div {
        background-color: var(--backgroundColor);
        padding-right: 1em;
        position: fixed;
        top: 0px;
        left: 0px;
        z-index: 10;
    }

    #navbar {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        align-content: end;
        height: 100%;
        width: 20%;
    }

    #title {
        font-family: var(--font-kalam), Georgia, serif;
        font-size: 3em;
        line-height: 1;
    }

    .text {
        text-align: right;
        font-size: 2em;
    }

    a {
        color: red;
        text-decoration: none;
        font-family: var(--font-dm-mono), monospace;
    }

    a:hover {
        color: rebeccapurple;
        text-decoration: underline;
    }
</style>
---
const backgroundColor = "rgb(197 211 178)";
const hoverBgColor = "rgb(151 164 133)";
const textColor = "rgb(65 76 48)";
---


<div id="navbar">
    <p class="text" id="title">Maddie Tavares</p>
    <a class="text" href="/">Home</a>
    <a class="text" href="#">Websites</a>
    <a href="/games" class="text">Games</a>
    <a class="text" href="#">Contact</a>
    <p id="copyright">copyright Madilyn (Maddie) Tavares 2026</p>
</div>

<style define:vars={{backgroundColor, textColor, hoverBgColor}}>
    div {
        background-color: var(--backgroundColor);
        padding-right: 1em;
        position: fixed;
        top: 0px;
        left: 0px;
        z-index: 10;
        border-right: 2px dashed rgb(65 76 48);
    }

    #navbar {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        align-content: end;
        height: 100%;
        width: 20%;
    }

    #title {
        font-family: var(--font-kalam), Georgia, serif;
        font-size: 3em;
        line-height: 1;
        padding-left: 1em;
        justify-self: end;
    }

    .text {
        text-align: right;
        font-size: 2em;
        color: var(--textColor);
    }

    a {
        text-decoration: none;
        font-family: var(--font-dm-mono), monospace;
    }

    a:hover {
        transition: transform 0.25s;
        background-color: var(--textColor);
        padding-right: 10px;
        transform: translateX(10%);
        color: var(--backgroundColor);
        text-decoration: underline;
    }

    #copyright {
        font-family: var(--font-dm-mono), monospace;
        font-size: 0.75em;
        position: fixed;
        bottom: 0px;
        left: 5px;
    }
</style>
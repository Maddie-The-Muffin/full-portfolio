---
const links = [
    { href: '/', label: 'Home' },
    { href: '/web-dev', label: 'Web Dev' },
    { href: '/games', label: 'Games' },
    { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header id="site-nav" class="site-nav">
    <div class="nav-bar">
        <p class="site-title"><a href="/">Maddie Tavares</a></p>

        <button
            id="nav-toggle"
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="nav-drawer"
        >
            <span class="visually-hidden">Toggle menu</span>
            <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
    </div>

    <nav id="nav-drawer" class="nav-drawer" aria-label="Primary">
        <ul>
            {links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class="nav-link"
                        aria-current={currentPath === link.href ? 'page' : undefined}
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
        <p class="copyright">&copy; Madilyn (Maddie) Tavares 2026</p>
    </nav>
</header>

<script>
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('nav-drawer');
    const nav = document.getElementById('site-nav');

    if (toggle && drawer && nav) {
        const closeDrawer = () => {
            drawer.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
        };

        toggle.addEventListener('click', () => {
            const isOpen = drawer.classList.toggle('open');
            toggle.setAttribute('aria-expanded', String(isOpen));
        });

        drawer.addEventListener('click', (event) => {
            if (event.target instanceof HTMLElement && event.target.closest('a')) {
                closeDrawer();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeDrawer();
            }
        });

        document.addEventListener('click', (event) => {
            if (
                drawer.classList.contains('open') &&
                event.target instanceof Node &&
                !nav.contains(event.target)
            ) {
                closeDrawer();
            }
        });
    }
</script>

<style>
    .site-title a {
        font-family: var(--font-heading);
        font-size: 1.8rem;
        color: var(--color-text);
        text-decoration: none;
    }

    .nav-toggle {
        display: none;
    }

    .copyright {
        font-size: 0.7rem;
        color: var(--color-text-muted);
        text-align: center;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }

    .nav-link {
        display: block;
        text-decoration: none;
        font-weight: 700;
        color: var(--color-text);
        padding: 0.5em 1em;
        border-radius: var(--radius-pill);
        text-align: center;
    }

    .nav-link:hover,
    .nav-link[aria-current='page'] {
        background: var(--color-primary-dark);
        color: var(--color-bg);
    }

    /* Desktop: fixed vertical sidebar */
    @media (min-width: 861px) {
        .site-nav {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--color-surface);
            border-right: 2px dashed var(--color-border);
            display: flex;
            flex-direction: column;
            padding: var(--space-4) var(--space-2);
            z-index: 20;
        }

        .nav-bar {
            display: flex;
            justify-content: center;
        }

        .site-title {
            margin: 0 0 var(--space-4);
            text-align: center;
        }

        .nav-drawer {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .copyright {
            margin-top: var(--space-3);
        }
    }

    /* Tablet/mobile: fixed top bar + toggled drawer */
    @media (max-width: 860px) {
        .site-nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 20;
        }

        .nav-bar {
            height: var(--topbar-height);
            background: var(--color-surface);
            border-bottom: 2px dashed var(--color-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 var(--space-3);
        }

        .site-title {
            margin: 0;
        }

        .site-title a {
            font-size: 1.4rem;
        }

        .nav-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 0;
        }

        .nav-toggle-bars {
            position: relative;
            display: block;
            width: 26px;
            height: 2px;
            background: var(--color-text);
            border-radius: 2px;
        }

        .nav-toggle-bars::before,
        .nav-toggle-bars::after {
            content: '';
            position: absolute;
            left: 0;
            width: 26px;
            height: 2px;
            background: var(--color-text);
            border-radius: 2px;
        }

        .nav-toggle-bars::before {
            top: -8px;
        }

        .nav-toggle-bars::after {
            top: 8px;
        }

        .nav-drawer {
            position: fixed;
            top: var(--topbar-height);
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--color-surface);
            transform: translateY(-100%);
            opacity: 0;
            visibility: hidden;
            transition: transform 0.25s ease, opacity 0.25s ease;
            padding: var(--space-4) var(--space-3);
            display: flex;
            flex-direction: column;
        }

        .nav-drawer.open {
            transform: translateY(0);
            opacity: 1;
            visibility: visible;
        }

        .nav-drawer ul {
            gap: 0.75em;
        }

        .nav-link {
            font-size: 1.3rem;
        }

        .copyright {
            margin-top: auto;
        }
    }

    @media (max-width: 480px) {
        .nav-drawer {
            background: rgba(241, 233, 216, 0.98);
        }

        .nav-link {
            font-size: 1.15rem;
        }

        .copyright {
            font-size: 0.65rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-drawer {
            transition: none;
        }
    }
</style>

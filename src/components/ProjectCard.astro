---
import { Image } from 'astro:assets';

interface ProjectLink {
    label: string;
    url: string;
}

interface Props {
    title: string;
    summary: string;
    tags?: string[];
    image?: ImageMetadata;
    imageAlt?: string;
    year?: number;
    meta?: string;
    primaryLink?: ProjectLink;
    secondaryLink?: ProjectLink;
}

const {
    title,
    summary,
    tags = [],
    image,
    imageAlt,
    year,
    meta,
    primaryLink,
    secondaryLink,
} = Astro.props;
---

<article class="project-card postcard">
    <div class="project-face">
        {image ? (
            <Image src={image} alt={imageAlt ?? title} loading="lazy" />
        ) : (
            <div class="placeholder-face" aria-hidden="true">
                <span>{title.charAt(0)}</span>
            </div>
        )}
    </div>

    <div class="project-body">
        <div class="project-heading">
            <h3>{title}</h3>
            {(year || meta) && (
                <p class="project-meta">
                    {meta}{meta && year ? ' · ' : ''}{year}
                </p>
            )}
        </div>

        <p class="project-summary">{summary}</p>

        {tags.length > 0 && (
            <ul class="project-tags">
                {tags.map((tag) => (
                    <li class="tag-pill">{tag}</li>
                ))}
            </ul>
        )}

        {(primaryLink || secondaryLink) && (
            <div class="project-links">
                {primaryLink && (
                    <a class="btn btn-primary" href={primaryLink.url}>{primaryLink.label}</a>
                )}
                {secondaryLink && (
                    <a class="btn btn-secondary" href={secondaryLink.url}>{secondaryLink.label}</a>
                )}
            </div>
        )}
    </div>
</article>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .project-card:nth-child(3n + 1) {
        transform: rotate(-0.6deg);
    }

    .project-card:nth-child(3n + 2) {
        transform: rotate(0.4deg);
    }

    .project-card:nth-child(3n + 3) {
        transform: rotate(-0.3deg);
    }

    .project-face {
        aspect-ratio: 16 / 10;
        overflow: hidden;
    }

    .project-face img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder-face {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    }

    .placeholder-face span {
        font-family: var(--font-heading);
        font-size: 3rem;
        color: var(--color-bg);
    }

    .project-body {
        padding: var(--space-2) var(--space-3) var(--space-3);
        display: flex;
        flex-direction: column;
        gap: 0.5em;
        flex: 1;
    }

    .project-heading h3 {
        margin-bottom: 0.15em;
    }

    .project-meta {
        margin: 0;
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }

    .project-summary {
        margin: 0;
        flex: 1;
    }

    .project-tags {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .project-links {
        display: flex;
        gap: 0.75em;
        flex-wrap: wrap;
        margin-top: 0.25em;
    }

    @media (max-width: 860px) {
        .project-card {
            max-width: 80%;
            margin: 0 auto var(--space-3) auto;
        }

        .project-card:last-child {
            margin: 0 auto;
        }

        .project-summary {
            font-size: 0.9rem;
        }
    }
</style>

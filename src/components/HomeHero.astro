---

<section class="hero">
    <p class="eyebrow">Hi, I'm Maddie 🌿</p>
    <h1>I build tech-forward yet human-first websites.</h1>
    <p class="tagline">
        Full-stack developer (PERN) with a soft spot for fantasy novels, nature walks, and
        preserving the humanity of the internet.
    </p>
    <div class="cta-row">
        <a class="btn btn-primary" href="/web-dev">See my web work</a>
        <a class="btn btn-secondary" href="/contact">Say hello</a>
    </div>
</section>

<style>
    .hero {
        width: var(--page-content-width);
        margin: 0 0 var(--space-5) auto;
        text-align: center;
    }

    .eyebrow {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        color: var(--color-secondary);
        margin-bottom: 0;
    }

    .hero h1 {
        margin-top: 0.1em;
    }

    .tagline {
        font-size: 1.15rem;
        color: var(--color-text-muted);
        width: 75%;
        margin: 0 auto var(--space-4);
    }

    .cta-row {
        display: flex;
        gap: 1em;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: var(--space-2);
    }

    @media (max-width: 860px) {
        .hero {
            width: 100%;
            margin: 0 auto;
            text-align: center;
        }
    }
</style>
